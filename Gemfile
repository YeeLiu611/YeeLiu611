source "https://rubygems.org"

# 指定 Jekyll 4.x 版本
gem "jekyll", "~> 4.2"

# Ruby 3.x 需要 webrick
gem "webrick", "~> 1.7"

# 回退到 jekyll-sass-converter 2.x，避免 sass-embedded 冲突
gem "jekyll-sass-converter", "~> 2.2"

# 可选：若报 “Could not find a valid gem 'sassc' ...” 或需要 SassC
gem "sassc", "~> 2.4"

gem "bigdecimal"